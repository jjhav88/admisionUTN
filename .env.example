APP_NAME=AdmiTomi
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Desarrollo (SQLite)
DATABASE_URL=sqlite:///./admitomi.db
# Producción / Docker (PostgreSQL)
# DATABASE_URL=postgresql://admitomi:admitomi@localhost:5432/admitomi

UPLOAD_DIR=app/static/uploads
DEBUG=true
COOKIE_NAME=access_token
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LOGIN_RATE_LIMIT=10/minute

# Admin inicial (solo se usa si el usuario "admin" no existe)
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@admitomi.com

# Limpieza de datos de tests en seed (por defecto: solo si DEBUG=true)
# SEED_CLEANUP_TESTS=false
